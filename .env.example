# --- Database (Postgres) ---------------------------------------------------
# Local:  postgres://postgres:postgres@localhost:5432/moneymaster
# Neon:   use the *pooled* connection string here ...
DATABASE_URL=
# ... and the direct (non-pooled) one here for migrations (optional locally).
DATABASE_URL_UNPOOLED=

# --- Auth.js -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: comma-separated list of Google accounts allowed to sign in.
# Leave empty to allow any Google account (each gets their own private data).
ALLOWED_EMAILS=

# Optional: local-only "sign in without Google" form. Ignored in production.
AUTH_DEV_LOGIN=false

# Defaults for new users (each user can change these in Settings).
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
